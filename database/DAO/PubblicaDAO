from database import Connessione
from database.Entity import Pubblica

class PubblicaDAO:
    def __init__(self):
        self.conn = Connessione().get_connection()
        self.cursor = self.conn.cursor()

    def __enter__(self):
        return self

    def __exit__(self, exc_type, exc_value, traceback):
        self.conn.close()

    def insert(self, id_canale: str, asin_prodotti: str) -> None:

        next_id = PubblicaDAO.__get_next_id

        self.cursor.execute('''INSERT INTO Pubblica (id, id_canale, asin_prodotti) 
                               VALUES (?, ?, ?)''', 
                               (next_id, id_canale, asin_prodotti,))
        self.conn.commit()

    def update(self, id: int, id_canale: str, asin_prodotti: str) -> None:
        self.cursor.execute('''UPDATE Pubblica 
                               SET id_canale = ?, asin_prodotti = ? 
                               WHERE id = ?''', 
                               (id_canale, asin_prodotti, id,))
        self.conn.commit()

    def delete(self, id: int, id_canale: str, asin_prodotti: str):
        self.cursor.execute("DELETE FROM Pubblica WHERE id = ? AND id_canale = ? AND asin_prodotti = ?", 
                            (id, id_canale, asin_prodotti))
        self.conn.commit()

    def get(self, id: int) -> Pubblica:
        self.cursor.execute("SELECT * FROM Pubblica WHERE id = ?", (id,))
        row = self.cursor.fetchone()
        if row:
            return Pubblica(row[0], row[1], row[2])
        return None

    def get_all(self) -> list:
        self.cursor.execute("SELECT * FROM Pubblica")
        rows = self.cursor.fetchall()
        return [Pubblica(row[0], row[1], row[2]) for row in rows]
    
    def close(self):
        self.conn.close()

    def __get_next_id(self) -> int:
        self.cursor.execute("SELECT MAX(id) FROM Pubblica")
        result = self.cursor.fetchone()

        if result[0] is None:
            next_id = 1
        else:
            next_id = result[0] + 1

        return next_id